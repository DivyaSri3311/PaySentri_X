# ==============================================================================
# PaySentriX Environment Configuration Template
# Copy this file to .env and insert your API credentials.
# Do NOT commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI API Configuration (Primary Vision, Whisper STT & AI Agent)
# ------------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model for natural language understanding and function-calling agent
OPENAI_MODEL=gpt-4o-mini

# OpenAI Vision Model for forensic payment screenshot extraction and visual analysis
OPENAI_VISION_MODEL=gpt-4o-mini

# API network timeout in seconds (safe default: 30 seconds)
OPENAI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 2. Google Gemini API Configuration (Optional Complementary Vision Fallback)
# ------------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Server & Networking Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
VITE_API_URL=http://localhost:8000
