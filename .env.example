# =================================================================
# PaySentriX — AI UPI Threat Shield & ProofPay Forensics (.env.example)
# Problem Statement: CyberCup 6.0 (CC6-AI02)
# Tagline: "A Screenshot Can Be Faked. A Transaction Must Be Verified."
# =================================================================

# Google Gemini API Configuration (Official Google GenAI SDK)
# Used for multimodal screenshot OCR & structured extraction in ProofPay
# and QR Guardian brand/POS signature verification.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Path (SQLite with SQLAlchemy / stdlib sqlite3)
# Defaults to backend/data/paysentrix.db
DATABASE_PATH=backend/data/paysentrix.db

# Merchant Ledger Simulation Mode
SIMULATION_MODE=True
